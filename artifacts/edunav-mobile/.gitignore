# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/
# …but DO track the App Store / Play Store screenshot folders, which
# happen to live under the same directory names inside assets/store/.
!assets/store/ios/
!assets/store/android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env

# EAS / store credentials — never commit
play-store-service-account.json
google-services.json
GoogleService-Info.plist
